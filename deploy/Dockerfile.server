FROM node:22-bookworm-slim
WORKDIR /app
COPY .generated/server/package*.json ./
RUN npm ci --omit=dev
COPY .generated/server/ ./
ENV PORT=9393 BOB_CONTAINER=1 AI_PROVIDER=ollama OLLAMA_URL=http://ollama:11434 OLLAMA_MODEL=qwen2.5:0.5b TTS_PROVIDER=custom CUSTOM_TTS_URL=http://piper:8022/tts CUSTOM_TTS_METHOD=POST CUSTOM_TTS_FORMAT=audio CUSTOM_TTS_BODY="{\"text\":\"{text}\"}" CUSTOM_TTS_HEADERS="Content-Type: application/json"
CMD ["node","src/index.js"]
